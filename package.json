{
  "name": "vitest-browser-examples",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@12.4.1",
  "description": "Examples of using Vitest Browser Mode with different frameworks",
  "keywords": [],
  "license": "MIT",
  "author": "Vladimir Sheremet",
  "scripts": {
    "test": "pnpm -r --filter !marko --filter !vue-msw-graphql --filter !@vitest-tests/browser-low-disk --sequential test -- --no-watch --browser.headless",
